# Variables de entorno de los microservicios (copiar a la configuración de run de IntelliJ o exportar en la terminal).
# NO subir los valores reales al repositorio.

# Mismo valor en ms-usuarios, ms-catalogo y ms-boletas (mínimo 32 caracteres).
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=grwu
DB_PASSWORD=

# Clave interna ms-boletas -> ms-catalogo (descontar/reponer stock). Mismo valor en ambos servicios.
SERVICE_KEY=cambia-esto-tambien
